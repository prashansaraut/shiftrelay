{
  "formTitle": "ShiftRelay — User Experience & Usability Evaluation",
  "formDescription": "Usability assessment and peer review questionnaire for the ShiftRelay Operational Continuity Single Page Application.",
  "settings": {
    "collectEmail": false,
    "limitToOneResponse": false,
    "allowEditAfterSubmit": true
  },
  "sections": [
    {
      "title": "Participant Demographics & Environment",
      "questions": [
        {
          "id": "Q01",
          "type": "short_text",
          "title": "Participant ID (e.g. USR-001)",
          "required": true
        },
        {
          "id": "Q02",
          "type": "multiple_choice",
          "title": "Role / Background",
          "options": [
            "Frontend Web Developer",
            "Full-Stack Engineer",
            "Operations Specialist",
            "UI/UX Evaluator",
            "Internship Mentor"
          ],
          "required": true
        },
        {
          "id": "Q03",
          "type": "multiple_choice",
          "title": "Evaluation Device",
          "options": [
            "Desktop Monitor (1080p+)",
            "Laptop (13-15 in)",
            "Tablet / iPad",
            "Foldable Phone",
            "Standard Smartphone"
          ],
          "required": true
        },
        {
          "id": "Q04",
          "type": "multiple_choice",
          "title": "Web Browser",
          "options": [
            "Google Chrome",
            "Mozilla Firefox",
            "Apple Safari",
            "Microsoft Edge"
          ],
          "required": true
        }
      ]
    },
    {
      "title": "Core Usability & Design Questions (Likert 1-5)",
      "questions": [
        {
          "id": "Q05",
          "type": "linear_scale",
          "title": "Clarity of Operational Purpose",
          "scaleMin": 1,
          "scaleMax": 5,
          "minLabel": "Unclear",
          "maxLabel": "Crystal Clear",
          "required": true
        },
        {
          "id": "Q06",
          "type": "linear_scale",
          "title": "Visual Hierarchy & Professional Polish",
          "scaleMin": 1,
          "scaleMax": 5,
          "minLabel": "Poor",
          "maxLabel": "Enterprise Grade",
          "required": true
        },
        {
          "id": "Q07",
          "type": "linear_scale",
          "title": "Problem vs. Solution Comprehension",
          "scaleMin": 1,
          "scaleMax": 5,
          "minLabel": "Confusing",
          "maxLabel": "Very Evident",
          "required": true
        },
        {
          "id": "Q08",
          "type": "linear_scale",
          "title": "Interactive Demo Flow & Usability",
          "scaleMin": 1,
          "scaleMax": 5,
          "minLabel": "Clunky",
          "maxLabel": "Seamless",
          "required": true
        },
        {
          "id": "Q09",
          "type": "linear_scale",
          "title": "Conflict Detection & Locking Realism",
          "scaleMin": 1,
          "scaleMax": 5,
          "minLabel": "Ineffective",
          "maxLabel": "Highly Realistic",
          "required": true
        },
        {
          "id": "Q10",
          "type": "linear_scale",
          "title": "Continuity Verification & ID Preservation",
          "scaleMin": 1,
          "scaleMax": 5,
          "minLabel": "Hard to follow",
          "maxLabel": "Exceptional Clarity",
          "required": true
        },
        {
          "id": "Q11",
          "type": "linear_scale",
          "title": "Workspace Navigation & Routing",
          "scaleMin": 1,
          "scaleMax": 5,
          "minLabel": "Slow / Cluttered",
          "maxLabel": "Fast & Intuitive",
          "required": true
        },
        {
          "id": "Q12",
          "type": "linear_scale",
          "title": "Simulated Role Switcher Utility",
          "scaleMin": 1,
          "scaleMax": 5,
          "minLabel": "Unhelpful",
          "maxLabel": "Highly Useful",
          "required": true
        },
        {
          "id": "Q13",
          "type": "linear_scale",
          "title": "Task Carry-Forward Aging Indicators",
          "scaleMin": 1,
          "scaleMax": 5,
          "minLabel": "Unnoticeable",
          "maxLabel": "Highly Prominent",
          "required": true
        },
        {
          "id": "Q14",
          "type": "linear_scale",
          "title": "Incident Mandatory Notes Protocol",
          "scaleMin": 1,
          "scaleMax": 5,
          "minLabel": "Too strict",
          "maxLabel": "Excellent Governance",
          "required": true
        },
        {
          "id": "Q15",
          "type": "linear_scale",
          "title": "Dark Theme Contrast & Polish",
          "scaleMin": 1,
          "scaleMax": 5,
          "minLabel": "Low Contrast",
          "maxLabel": "Flawless Contrast",
          "required": true
        },
        {
          "id": "Q16",
          "type": "linear_scale",
          "title": "Mobile & Tablet Responsiveness",
          "scaleMin": 1,
          "scaleMax": 5,
          "minLabel": "Broken Layouts",
          "maxLabel": "Fully Responsive",
          "required": true
        }
      ]
    },
    {
      "title": "Qualitative Feedback & Overall Score",
      "questions": [
        {
          "id": "Q17",
          "type": "paragraph",
          "title": "Strongest feature in ShiftRelay",
          "required": false
        },
        {
          "id": "Q18",
          "type": "paragraph",
          "title": "Areas for improvement or observed friction",
          "required": false
        },
        {
          "id": "Q19",
          "type": "paragraph",
          "title": "Recommended feature additions for future versions",
          "required": false
        },
        {
          "id": "Q20",
          "type": "linear_scale",
          "title": "Overall System Usability Rating (1-10)",
          "scaleMin": 1,
          "scaleMax": 10,
          "minLabel": "Poor",
          "maxLabel": "Outstanding",
          "required": true
        }
      ]
    }
  ]
}