erDiagram
  EMPLOYEE ||--o{ SHIFT : "assigned to"
  SHIFT ||--o{ TASK : "contains open"
  SHIFT ||--o{ INCIDENT : "contains open"
  SHIFT ||--o{ HANDOVER : "outgoing shift (fromShift)"
  SHIFT ||--o{ HANDOVER : "incoming shift (toShift)"
  
  HANDOVER ||--o{ TASK : "carries forward (taskIds)"
  HANDOVER ||--o{ INCIDENT : "carries forward (incidentIds)"
  
  TASK ||--o{ ACTIVITY : "generates audit"
  INCIDENT ||--o{ ACTIVITY : "generates audit"
  HANDOVER ||--o{ ACTIVITY : "generates audit"

  EMPLOYEE {
    string id PK
    string name
    string role
  }

  SHIFT {
    string id PK
    string name
    string dept
    string start
    string end
    string status
    stringList staff FK
  }

  HANDOVER {
    string id PK
    string title
    string fromShift FK
    string toShift FK
    string outgoing
    string incoming
    string status
    stringList taskIds FK
    stringList incidentIds FK
    string ackBy
    string ackAt
  }

  TASK {
    string id PK
    string title
    string desc
    string cat
    string priority
    string assignee
    string shiftId FK
    string due
    string status
    int carry
    string closedShift FK
  }

  INCIDENT {
    string id PK
    string title
    string desc
    string category
    string dept
    string severity
    string reportedBy
    string assignee
    string shiftId FK
    string status
    string resolution
    int carry
    string closedShift FK
  }

  ACTIVITY {
    string id PK
    string at
    string text
    string ref FK
    string user
  }
